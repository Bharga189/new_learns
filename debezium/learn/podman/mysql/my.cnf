# MySQL settings required by the Debezium MySQL connector.
#
# The binlog is the source of truth for CDC. Debezium cannot capture changes
# unless the server id is set and the binlog uses ROW format with FULL row
# images (the "before" values are needed for update/delete events).

[mysqld]
server-id=1
log-bin=mysql-bin
binlog-format=ROW
binlog-row-image=FULL
binlog-expire-logs-seconds=86400
max-binlog-size=100M

# Debezium's MySQL connector uses the native password protocol in this local
# demo. Keep this out of production, where TLS and stronger auth are expected.
default-authentication-plugin=mysql_native_password

character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
