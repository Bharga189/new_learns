<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>java_featues</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Java Features</name>
    <description>Single Maven project aggregating Java version feature examples as submodules, from Java 8 to Java 25.</description>

    <modules>
        <module>java8</module>
        <module>java9</module>
        <module>java10</module>
        <module>java11</module>
        <module>java12</module>
        <module>java13</module>
        <module>java14</module>
        <module>java15</module>
        <module>java16</module>
        <module>java17</module>
        <module>java18</module>
        <module>java19</module>
        <module>java20</module>
        <module>java21</module>
        <module>java22</module>
        <module>java23</module>
        <module>java24</module>
        <module>java25</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Every version module inherits the JUnit 5 test stack. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
